@article{Youssry2013,
 abstract = {We report on the rheological and electrical properties of non-aqueous carbon black (CB) suspensions at equilibrium and under steady shear flow. The smaller the primary particle size of carbon black is, the higher the magnitude of rheological parameters and the conductivity are. The electrical percolation threshold ranges seem to coincide with the strong gel rather than the weak gel rheological threshold ones. The simultaneous measurements of electrical properties under shear flow reveal the well-known breaking-and-reforming mechanism that characterises such complex fluids. The small shear rate breaks up the network into smaller agglomerates, which in turn transform into anisometric eroded ones at very high shear rates, recovering the network conductivity. The type of carbon black, its concentration range and the flow rate range are now precisely identified for optimizing the performance of a redox flow battery. A preliminary electrochemical study for a composite anolyte (CB/Li4Ti5O12) at different charge-discharge rates and thicknesses is shown.},
 author = {Mohamed Youssry and Lénaïc Madec and Patrick Soudan and Manuella Cerbelaud and Dominique Guyomard and Bernard Lestriez},
 doi = {10.1039/c3cp51371h},
 issn = {1463-9084},
 issue = {34},
 journal = {Physical chemistry chemical physics : PCCP},
 pages = {14476-86},
 pmid = {23892887},
 title = {Non-aqueous carbon black suspensions for lithium-based redox flow batteries: rheology and simultaneous rheo-electrical behavior.},
 url = {http://www.ncbi.nlm.nih.gov/pubmed/23892887},
 volume = {15},
 year = {2013}
}
