   month = {3},
   pages = {323-332},
   pmid = {26692496},
   publisher = {Elsevier Inc.},
   title = {Novel nanoporous MnOx (x=∼1.75) sorbent for the removal of SO2 and NH3 made from MnC2O4·2H2O},
