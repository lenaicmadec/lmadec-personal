   pages = {152-163},
   publisher = {Elsevier B.V},
   title = {Study of the consumption of the additive prop-1-ene-1,3-sultone in Li[Ni0.33Mn0.33Co0.33]O2/graphite pouch cells and evidence of positive-negative electrode interaction},
   volume = {313},
   year = {2016}
}
